#include <stdio.h>
#include <stdlib.h>

#define MOD 26

// Function to compute modular inverse of a number mod 26
int modInverse(int a) {
    a = a % MOD;
    for (int x = 1; x < MOD; x++) {
        if ((a * x) % MOD == 1) return x;
    }
    return -1; // No inverse
}

// Function to solve for key matrix given plaintext and ciphertext
void recoverKey(int P[2][2], int C[2][2], int K[2][2]) {
    // Compute determinant of P
    int det = (P[0][0]*P[1][1] - P[0][1]*P[1][0]) % MOD;
    if (det < 0) det += MOD;

    int invDet = modInverse(det);
    if (invDet == -1) {
        printf("Plaintext matrix not invertible mod 26.\n");
        return;
    }

    // Compute adjugate of P
    int adj[2][2];
    adj[0][0] = P[1][1];
    adj[0][1] = -P[0][1];
    adj[1][0] = -P[1][0];
    adj[1][1] = P[0][0];

    // Normalize modulo 26
    for (int i=0;i<2;i++) {
        for (int j=0;j<2;j++) {
            adj[i][j] = (adj[i][j] % MOD + MOD) % MOD;
        }
    }

    // Compute inverse of P
    int Pinv[2][2];
    for (int i=0;i<2;i++) {
        for (int j=0;j<2;j++) {
            Pinv[i][j] = (adj[i][j] * invDet) % MOD;
        }
    }

    // Recover key: K = C * P^-1
    for (int i=0;i<2;i++) {
        for (int j=0;j<2;j++) {
            K[i][j] = 0;
            for (int k=0;k<2;k++) {
                K[i][j] += C[i][k] * Pinv[k][j];
            }
            K[i][j] %= MOD;
        }
    }
}

int main() {
    // Example: Suppose attacker knows plaintext "ME" -> [12,4] and "ET" -> [4,19]
    // Ciphertext pairs (from encryption with unknown key)
    int P[2][2] = {{12,4},{4,19}};   // plaintext vectors
    int C[2][2] = {{20,14},{7,3}};   // ciphertext vectors (example)

    int K[2][2];
    recoverKey(P,C,K);

    printf("Recovered Key Matrix:\n");
    for (int i=0;i<2;i++) {
        for (int j=0;j<2;j++) {
            printf("%d ", K[i][j]);
        }
        printf("\n");
    }
    return 0;
}
